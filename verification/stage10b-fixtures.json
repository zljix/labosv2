{"softwareBmp280":{"project":{"format":"esp32-micropython-lab","schemaVersion":3,"id":"83cf8833-21f1-4c79-a039-9cb8749b13e8","title":"BMP280 software I2C reference","createdAt":"2026-11-12T21:02:04.994Z","updatedAt":"2026-11-12T21:02:04.994Z","revision":0,"board":{"id":"arduino.uno-r3.atmega328p","profileVersion":"0.1.0"},"language":"arduino-cpp","runtimeProfile":{"id":"arduino-avr","version":1},"entryFile":"main.ino","nodeId":"main","target":{"fqbn":"arduino:avr:uno"},"files":{"main.ino":"// Reference software-I2C master: only Arduino GPIO, no simulator calls.\nconst byte SDA_PIN=6, SCL_PIN=7;\nvoid low(byte p) { digitalWrite(p,LOW); pinMode(p,OUTPUT); }\nvoid release(byte p) { pinMode(p,INPUT); }\nvoid highClock() { release(SCL_PIN); delayMicroseconds(4); }\nvoid lowClock() { low(SCL_PIN); delayMicroseconds(4); }\nvoid startBus() { release(SDA_PIN); highClock(); low(SDA_PIN); lowClock(); }\nvoid stopBus() { low(SDA_PIN); highClock(); release(SDA_PIN); delayMicroseconds(4); }\nbool writeByte(byte value) {\n  for(byte i=0;i<8;i++) { if(value&128)release(SDA_PIN);else low(SDA_PIN); highClock();lowClock();value<<=1; }\n  release(SDA_PIN);highClock();bool ack=digitalRead(SDA_PIN)==LOW;lowClock();return ack;\n}\nbyte readByte(bool ack) {\n  byte value=0;release(SDA_PIN);\n  for(byte i=0;i<8;i++) {highClock();value=(value<<1)|digitalRead(SDA_PIN);lowClock();}\n  if(ack)low(SDA_PIN);else release(SDA_PIN);highClock();lowClock();release(SDA_PIN);return value;\n}\nvoid setup(){\n Serial.begin(9600);delay(20);bool ack=true;\n startBus();ack &= writeByte(0xec);ack &= writeByte(0xd0);\n startBus();ack &= writeByte(0xed);byte chip=readByte(false);stopBus();\n startBus();ack &= writeByte(0xec);ack &= writeByte(0x88);\n startBus();ack &= writeByte(0xed);byte b[6];for(byte i=0;i<6;i++)b[i]=readByte(i<5);stopBus();\n Serial.print(F(\"SOFT ACK=\"));Serial.println(ack);Serial.print(F(\"CHIP=\"));Serial.println(chip);\n Serial.print(F(\"CAL=\"));for(byte i=0;i<6;i++){Serial.print(b[i]);Serial.print(',');}Serial.println();\n}\nvoid loop(){delay(1000);}\n"},"circuit":{"kind":"editable","modelVersion":1,"components":[{"id":"board","kind":"board","x":40,"y":120,"label":"Uno R3","rotation":0,"properties":{"boardProfileId":"arduino.uno-r3.atmega328p"}},{"id":"bmp2801","kind":"bmp280","x":600,"y":100,"label":"BMP280","rotation":0,"properties":{"temperature":24,"pressure":101325,"pullups":true,"address":118,"moduleVoltage":5}}],"wires":[{"id":"env0","from":{"component":"board","pin":"5V"},"to":{"component":"bmp2801","pin":"VCC"},"color":"#d04b46","points":[]},{"id":"env1","from":{"component":"board","pin":"GND"},"to":{"component":"bmp2801","pin":"GND"},"color":"#334155","points":[]},{"id":"env2","from":{"component":"board","pin":"D6"},"to":{"component":"bmp2801","pin":"SDA"},"color":"#087f8c","points":[]},{"id":"env3","from":{"component":"board","pin":"D7"},"to":{"component":"bmp2801","pin":"SCL"},"color":"#d59218","points":[]}]},"settings":{"activeFile":"main.ino","theme":"light","fontSize":14,"powered":true,"swapped":false,"example":""}},"artifact":{"format":"esp32-lab-avr-build","version":1,"boardId":"arduino.uno-r3.atmega328p","boardProfile":"0.1.0","fqbn":"arduino:avr:uno","toolchain":{"cli":"1.3.1","core":"arduino:avr@1.8.6","gcc":"7.3.0-atmel3.6.1-arduino7","libraries":[]},"inputHash":"7b8aafc966ae854b862674fbc41eef1672d0de2ae2e99b29282d8e559538bc7b","hexHash":"f6ee1948bb211742e58d878594acfdd6e837eef01b4e75c088fc4cfec8e14f0c","hex":":100000000C946D000C9495000C9495000C94950044\r\n:100010000C9495000C9495000C9495000C9495000C\r\n:100020000C9495000C9495000C9495000C949500FC\r\n:100030000C9495000C9495000C9495000C949500EC\r\n:100040000C949C030C9495000C940C040C94E60303\r\n:100050000C9495000C9495000C9495000C949500CC\r\n:100060000C9495000C9495000000000025002800D9\r\n:100070002B0000000000240027002A0043414C3DD3\r\n:1000800000434849503D00534F46542041434B3DA7\r\n:1000900000000000002300260029000404040404DA\r\n:1000A0000404040202020202020303030303030125\r\n:1000B0