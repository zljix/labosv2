{"softwareLcd":{"project":{"format":"esp32-micropython-lab","schemaVersion":3,"id":"0315ae8e-9013-4f6e-a440-95d5d2fcc177","title":"LCD software I2C reference","createdAt":"2026-11-12T21:28:51.267Z","updatedAt":"2026-11-12T21:28:51.267Z","revision":0,"board":{"id":"arduino.uno-r3.atmega328p","profileVersion":"0.1.0"},"language":"arduino-cpp","runtimeProfile":{"id":"arduino-avr","version":1},"entryFile":"main.ino","nodeId":"main","target":{"fqbn":"arduino:avr:uno"},"files":{"main.ino":"// Reference software-I2C master: only Arduino GPIO, no simulator calls.\nconst byte SDA_PIN=6, SCL_PIN=7;\nvoid low(byte p) { digitalWrite(p,LOW); pinMode(p,OUTPUT); }\nvoid release(byte p) { pinMode(p,INPUT); }\nvoid highClock() { release(SCL_PIN); delayMicroseconds(4); }\nvoid lowClock() { low(SCL_PIN); delayMicroseconds(4); }\nvoid startBus() { release(SDA_PIN); highClock(); low(SDA_PIN); lowClock(); }\nvoid stopBus() { low(SDA_PIN); highClock(); release(SDA_PIN); delayMicroseconds(4); }\nbool writeByte(byte value) {\n  for(byte i=0;i<8;i++) { if(value&128)release(SDA_PIN);else low(SDA_PIN); highClock();lowClock();value<<=1; }\n  release(SDA_PIN);highClock();bool ack=digitalRead(SDA_PIN)==LOW;lowClock();return ack;\n}\nbyte readByte(bool ack) {\n  byte value=0;release(SDA_PIN);\n  for(byte i=0;i<8;i++) {highClock();value=(value<<1)|digitalRead(SDA_PIN);lowClock();}\n  if(ack)low(SDA_PIN);else release(SDA_PIN);highClock();lowClock();release(SDA_PIN);return value;\n}\n\nbool ack=true;\nvoid port(byte v){startBus();ack &= writeByte(0x4e);ack &= writeByte(v);stopBus();}\nvoid nibble(byte n,byte rs=0){byte v=(n<<4)|8|rs;port(v);port(v|4);port(v);}\nvoid lcdByte(byte v,byte rs=0){nibble(v>>4,rs);nibble(v&15,rs);delayMicroseconds(50);if(!rs&&v<4)delay(2);}\nbyte readNibble(){port(0xfb);port(0xff);startBus();ack &= writeByte(0x4f);byte v=readByte(false);stopBus();port(0xfb);return v>>4;}\nvoid setup(){\n Serial.begin(9600);delay(50);port(8);delay(1);\n nibble(3);delay(5);nibble(3);delay(1);nibble(3);delay(1);nibble(2);delay(1);\n lcdByte(0x28);lcdByte(0x0c);lcdByte(6);lcdByte(1);\n const char* s=\"SW LCD\";while(*s)lcdByte(*s++,1);\n lcdByte(0x80);byte high=readNibble(),low=readNibble();\n Serial.print(F(\"SOFT_LCD ACK=\"));Serial.print(ack);Serial.print(F(\" READ=\"));Serial.println((high<<4)|low);\n}\nvoid loop(){delay(1000);}\n"},"circuit":{"kind":"editable","modelVersion":1,"components":[{"id":"board","kind":"board","x":40,"y":95,"label":"Uno R3","rotation":0,"properties":{"boardProfileId":"arduino.uno-r3.atmega328p"}},{"id":"display1","kind":"lcd1602","x":600,"y":80,"label":"LCD1602","rotation":0,"properties":{"address":39,"pullups":true,"moduleVoltage":5,"logicVoltage":5}}],"wires":[{"id":"displayWire0","from":{"component":"board","pin":"IOREF"},"to":{"component":"display1","pin":"VCC"},"color":"#d04b46","points":[]},{"id":"displayWire1","from":{"component":"board","pin":"GND"},"to":{"component":"display1","pin":"GND"},"color":"#334155","points":[]},{"id":"displayWire2","from":{"component":"board","pin":"D6"},"to":{"component":"display1","pin":"SDA"},"color":"#087f8c","points":[]},{"id":"displayWire3","from":{"component":"board","pin":"D7"},"to":{"component":"display1","pin":"SCL"},"color":"#d59218","points":[]},{"id":"displayWire4","from":{"component":"board","pin":"IOREF"},"to":{"component":"display1","pin":"LV"},"color":"#8b52ba","points":[]}]},"settings":{"activeFile":"main.ino","theme":"light","fontSize":14,"powered":true,"swapped":false,"example":""}},"artifact":{"format":"esp32-lab-avr-build","version":1,"boardId":"arduino.uno-r3.atmega328p","boardProfile":"0.1.0","fqbn":"arduino:avr:uno","toolchain":{"cli":"1.3.1","core":"arduino:avr@1.8.6","gcc":"7.3.0-atmel3.6.1-arduino7","libraries":[]},"inputHash":"9d13b8316f65ff8d3ea00b5f8de21b79fa3d192248dce6567356e53e2025c55d","hexHash":"47ba339bf7493d6f134c0c4a68b7c65de300e405ffacfc6a68222db1f3267951","hex":":100000000C946D000C9495000C9495000C94950044\r\n:100010000C9495000C9495000C9495000C9495000